    {
      "name": "Test",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "",
              "// 1) 200 OK",
              "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
              "",
              "// 2) data is an array",
              "pm.test(\"Response has a data array\", () => {",
              "  pm.expect(res.data).to.be.an(\"array\");",
              "});",
              "",
              "// 3) each user has required fields",
              "pm.test(\"Each user has required fields\", () => {",
              "  res.data.forEach(u => {",
              "    pm.expect(u).to.include.all.keys(",
              "      \"_id\",\"firstName\",\"lastName\",\"email\",\"age\",\"createdAt\"",
              "    );",
              "  });",
              "});",
              ""
