    {
      "name": "Test by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "const user = res.data;",
              "",
              "// 1) 200 OK",
              "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
              "",
              "// 2) data is an object",
              "pm.test(\"Response data is an object\", () => {",
              "  pm.expect(user).to.be.an(\"object\");",
              "});",
              "",
              "// 3) correct _id (from the URL)",
              "pm.test(\"Returned user has correct _id\", () => {",
              "  // pm.request.url.path is an array like [\"users\", \"<the-id>\"]",
              "  const pathSegments = pm.request.url.path;",
              "  const idFromUrl = pathSegments[pathSegments.length - 1];",
              "  pm.expect(user._id).to.eql(idFromUrl);",
              "});",
              "",
              "// 4) object has required fields",
              "pm.test(\"User object has required fields\", () => {",
              "  pm.expect(user).to.include.all.keys(",
              "    \"_id\",\"firstName\",\"lastName\",\"email\",\"age\",\"createdAt\"",
              "  );",
              "});",
              ""
