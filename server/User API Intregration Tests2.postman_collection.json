    {
      "name": "Add User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// parse the JSON response",
              "const json = pm.response.json();",
              "// fall back to an empty object if data is missing",
              "const user = json.data || {};",
              "",
              "// 1) Status code is 200 or 201",
              "pm.test(\"Status code is 200 or 201\", () => {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "",
              "// 2) response has a data object",
              "pm.test(\"Response has a data object\", () => {",
              "    pm.expect(json).to.have.property(\"data\");",
              "    pm.expect(json.data).to.be.an(\"object\");",
              "});",
              "",
              "// 3) user object has the required fields",
              "pm.test(\"User object has required fields\", () => {",
              "    pm.expect(user).to.include.all.keys(",
              "        \"_id\",",
              "        \"firstName\",",
              "        \"lastName\",",
              "        \"email\",",
              "        \"age\",",
              "        \"createdAt\"",
              "    );",
              "});",
              "",
              "// 4) save the new userId for subsequent requests (only if it exists)",
              "if (user._id) {",
              "    pm.environment.set(\"userId\", user._id);",
              "}",
              ""
            ],
            "type": "text/javascript",
            "packages": {}
          }
        },
