            {
              "name": "Defaults",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "// 1) Status 200",
                      "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                      "",
                      "const json = pm.response.json();",
                      "",
                      "// 2) Has results, page, data",
                      "pm.test(\"Has envelope keys\", () => {",
                      "  pm.expect(json).to.have.property(\"results\");",
                      "  pm.expect(json).to.have.property(\"page\");",
                      "  pm.expect(json).to.have.property(\"data\");",
                      "  pm.expect(json.data).to.be.an(\"array\");",
                      "});",
                      "",
                      "// 3) results matches data.length",
                      "pm.test(\"results matches data length\", () => {",
                      "  pm.expect(json.results).to.eql(json.data.length);",
                      "});",
                      "",
                      "// 4) default page is 1",
                      "pm.test(\"default page is 1\", () => {",
                      "  pm.expect(json.page).to.eql(1);",
                      "});",
                      ""
                    ],
                    "type": "text/javascript",
                    "packages": {}
                  }
                }
