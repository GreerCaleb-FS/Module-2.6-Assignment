                      "// 1) Only users older than 30",
                      "pm.test(\"All users have age > 30\", () => {",
                      "  data.forEach(u => pm.expect(u.age).to.be.above(30));",
                      "});",
                      "",
                      "// 2) email field excluded",
                      "pm.test(\"email field is excluded\", () => {",
                      "  data.forEach(u => pm.expect(u).to.not.have.property(\"email\"));",
