    {
      "name": "Delete User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// try to parse JSON (if your DELETE returns no body, this will throw and we skip the JSON‐specific tests)",
              "let json;",
              "try {",
              "    json = pm.response.json();",
              "} catch (e) {",
              "    json = {};",
              "}",
              "",
              "// grab the deleted resource ",
              "const deleted = json.data;",
              "",
              "// 1) status code is 200 or 204",
              "pm.test(\"Status code is 200 or 204\", () => {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
              "});",
              "",
              "// only run the JSON‐body tests if there *is* a body",
              "if (pm.response.code === 200) {",
              "    // 2) response has a data object",
              "    pm.test(\"Response data is an object\", () => {",
              "        pm.expect(deleted).to.be.an(\"object\");",
              "    });",
              "",
              "    // 3) deleted user has the correct _id (pulled from the URL)",
              "    pm.test(\"Deleted user has correct _id\", () => {",
              "        const segments = pm.request.url.path;",
              "        const idFromUrl = segments[segments.length - 1];",
              "        pm.expect(deleted._id).to.eql(idFromUrl);",
              "    });",
              "",
              "    // 4) deleted object still had all the expected fields",
              "    pm.test(\"Deleted user object has required fields\", () => {",
              "        pm.expect(deleted).to.include.all.keys(",
              "            \"_id\",",
              "            \"firstName\",",
              "            \"lastName\",",
              "            \"email\",",
              "            \"age\",",
              "            \"createdAt\"",
              "        );",
              "    });",
              "}",
              "",
              "// 5) clean up: remove the userId env var now that it’s gone",
              "pm.environment.unset(\"userId\");",
              ""
            ],
            "type": "text/javascript",
            "packages": {}
          }
        },
